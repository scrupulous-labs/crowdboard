{
  "name": "crowdboard",
  "version": "1.0.0",
  "description": "",
  "author": "Pavan Varma",
  "scripts": {
    "docker:reset": "make -C ./tooling/docker reset-dev-services",
    "docker:start": "make -C ./tooling/docker start-dev-services",
    "docker:stop": "make -C ./tooling/docker stop-dev-services",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "oxlint:patch": "effect-tsgo patch --oxlint",
    "oxlint:unpatch": "effect-tsgo unpatch --oxlint",
    "psql": "make -C ./tooling/docker connect-dev-db",
    "psql:reset": "pnpm run docker:reset && pnpm run docker:start && pnpm run psql",
    "psql:start": "pnpm run docker:start && pnpm run psql"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
