{
  "name": "@crowdboard-backend/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:clear": "tsx ./scripts/db-clear.ts",
    "db:migrate": "tsx ./scripts/db-migrate.ts",
    "generate:auth-migration": "auth generate --config ./scripts/auth-migration.ts --output ./tmp/AUTH-MIGRATIONS.sql --yes",
    "generate:auth-schema": "auth generate --config ./scripts/auth-schema.ts --output ./tmp/AUTH-SCHEMA.ts --yes",
    "generate:jobs-migration": "tsx ./scripts/jobs-migration.ts",
    "generate:migrations": "rm -rf ./tmp && pnpm generate:jobs-migration && pnpm generate:auth-migration && pnpm generate:auth-schema",
    "generate:schema": "rm -rf ./tmp && pnpm generate:auth-schema"
  },
  "dependencies": {
    "@crowdboard-backend/env": "workspace:*",
    "@effect/sql-pg": "catalog:effect",
    "drizzle-orm": "catalog:drizzle",
    "effect": "catalog:effect",
    "node-pg-migrate": "catalog:postgres",
    "pg": "catalog:postgres",
    "pg-boss": "catalog:postgres"
  },
  "devDependencies": {
    "@crowdboard-backend/auth": "workspace:*",
    "@crowdboard-tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "catalog:types",
    "auth": "catalog:better-auth",
    "tsx": "catalog:build"
  }
}
