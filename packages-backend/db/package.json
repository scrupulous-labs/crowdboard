{
  "name": "@crowdboard-backend/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:clear": "tsx ./scripts/db-clear.ts",
    "db:migrate": "tsx ./scripts/db-migrate.ts",
    "generate:migration": "rm -rf ./tmp && pnpm generate:migration:auth && pnpm generate:migration:jobs",
    "generate:migration:auth": "auth generate --config ./scripts/migration-auth.ts --output ./tmp/MIGRATIONS-AUTH.sql --yes",
    "generate:migration:jobs": "tsx ./scripts/migration-jobs.ts",
    "generate:schema": "rm -rf ./tmp && pnpm generate:schema:auth",
    "generate:schema:auth": "auth generate --config ./scripts/schema-auth.ts --output ./tmp/SCHEMA-AUTH.ts --yes"
  },
  "dependencies": {
    "@crowdboard-backend/env": "workspace:*",
    "@effect/sql-pg": "catalog:effect",
    "drizzle-orm": "catalog:drizzle",
    "effect": "catalog:effect",
    "node-pg-migrate": "catalog:postgres",
    "pg": "catalog:postgres"
  },
  "devDependencies": {
    "@crowdboard-backend/auth": "workspace:*",
    "@crowdboard-tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "catalog:types",
    "auth": "catalog:better-auth",
    "pg-boss": "catalog:postgres",
    "tsx": "catalog:build"
  }
}
