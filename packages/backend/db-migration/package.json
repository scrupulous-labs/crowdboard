{
  "name": "@crowdboard-backend/db-migration",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "db:clear": "tsx ./scripts/db-clear.ts",
    "db:migrate": "tsx ./scripts/db-migrate.ts",
    "generate:auth": "rm -rf ./tmp && pnpm generate:auth-migration && pnpm generate:auth-schema",
    "generate:auth-migration": "auth generate --config ./scripts/auth.ts --output ./tmp/COPY-TO-MIGRATIONS.sql --yes",
    "generate:auth-schema": "auth generate --config ./scripts/auth.drizzle.ts --output ./tmp/COPY-TO-DB_SCHEMA.ts --yes"
  },
  "dependencies": {
    "@crowdboard-backend/db": "workspace:*",
    "@crowdboard-backend/env": "workspace:*",
    "effect": "catalog:effect",
    "node-pg-migrate": "catalog:postgres",
    "pg": "catalog:postgres"
  },
  "devDependencies": {
    "@crowdboard-backend/auth": "workspace:*",
    "@crowdboard-tooling/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "catalog:types",
    "auth": "catalog:better-auth",
    "drizzle-orm": "catalog:drizzle",
    "tsx": "catalog:build"
  }
}
